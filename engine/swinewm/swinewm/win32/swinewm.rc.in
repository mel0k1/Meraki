// Icon and version information for meraki.exe (configured by CMake).
#include <winver.h>

1 ICON "@SWINEWM_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
        BLOCK "StringFileInfo"
        BEGIN
                BLOCK "040904B0"
                BEGIN
                        VALUE "FileDescription", "Meraki Desktop Environment"
                        VALUE "FileVersion", "@SWINEWM_VERSION@"
                        VALUE "ProductName", "Meraki"
                        VALUE "ProductVersion", "@SWINEWM_VERSION@"
                        VALUE "LegalCopyright", "MIT License"
                        VALUE "OriginalFilename", "meraki.exe"
                END
        END
        BLOCK "VarFileInfo"
        BEGIN
                VALUE "Translation", 0x0409, 1200
        END
END
